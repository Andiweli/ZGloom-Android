static void TintFontPaletteRed(Font& font)
{
	SDL_Palette* src = font.GetPalette();
	if (!src) return;

	SDL_Surface* palSurface = SDL_CreateRGBSurface(0, 1, 1, 8, 0, 0, 0, 0);
	if (!palSurface || !palSurface->format || !palSurface->format->palette)
	{
		if (palSurface) SDL_FreeSurface(palSurface);
		return;
	}

	SDL_Color colors[256];
	for (int i = 0; i < 256; i++)
	{
		colors[i].r = 0;
		colors[i].g = 0;
		colors[i].b = 0;
		colors[i].a = 0xFF;
	}

	int ncolors = src->ncolors;
	if (ncolors > 256) ncolors = 256;
	for (int i = 1; i < ncolors; i++)
	{
		Uint8 brightness = src->colors[i].r;
		if (src->colors[i].g > brightness) brightness = src->colors[i].g;
		if (src->colors[i].b > brightness) brightness = src->colors[i].b;
		if (brightness < 0x70) brightness = 0x70;

		colors[i].r = brightness;
		colors[i].g = 0;
		colors[i].b = 0;
		colors[i].a = 0xFF;
	}

	SDL_SetPaletteColors(palSurface->format->palette, colors, 0, 256);
	font.SetPal(palSurface);
	SDL_FreeSurface(palSurface);
}

static Font* GetHudSmallFont()
{
	// The normal game/menu "smallfont" argument can actually be bigfont2.bin
	// on modern data sets because zgloom.cpp loads bigfont2 into both Font
	// objects when that file exists.  The HUD must use the real Gloom
	// smallfont.bin, otherwise HEALTH/WEAPON are rendered too wide.
	static Font* hudSmallFont = nullptr;
	static bool attemptedLoad = false;
	static bool loaded = false;

	if (!attemptedLoad)
	{
		attemptedLoad = true;
		hudSmallFont = new Font();

		CrmFile fontfile;
		fontfile.Load((Config::GetMiscDir() + "smallfont.bin").c_str());
		if (fontfile.data)
		{
			loaded = hudSmallFont->Load(fontfile);
			if (loaded)
			{
				TintFontPaletteRed(*hudSmallFont);
			}
		}
	}

	return loaded ? hudSmallFont : nullptr;
}

static void DrawHudText(Font& font, const char* text, int x, int y, SDL_Surface* dest, int scale)
{
	if (!text || !dest) return;

	int drawX = x * scale;
	const int drawY = y * scale;
	const int advance = 6 * scale;

	for (const char* c = text; *c; ++c)
	{
		int glyph = -1;
		if (*c >= '0' && *c <= '9')
		{
			glyph = *c - '0';
		}
		else if (*c >= 'A' && *c <= 'Z')
		{
			glyph = *c - 'A' + 10;
		}
		else if (*c >= 'a' && *c <= 'z')
		{
			glyph = *c - 'a' + 10;
		}
		else if (*c == '!')
		{
			glyph = 36;
		}
		else if (*c == '.')
		{
			glyph = 37;
		}
		else if (*c == ':')
		{
			glyph = 38;
		}

		if (glyph >= 0)
		{
			font.Blit(drawX, drawY, glyph, dest, scale);
		}

		drawX += advance;
	}
}

static float g_weapon_tint[5][3] = {
    {1.0f, 0.97f, 0.94f},
    {1.0f, 0.97f, 0.94f},
    {1.0f, 0.97f, 0.94f},
    {1.0f, 0.97f, 0.94f},
    {1.0f, 0.97f, 0.94f}
};

static inline void ComputeWeaponTintsFromIcons(SDL_Surface* icons[5]) {
    for (int i = 0; i < 5; ++i) {
        SDL_Surface* s = icons[i];
        if (!s) continue;
        uint64_t sumR = 0, sumG = 0, sumB = 0; int count = 0;
        for (int y = 0; y < s->h; ++y) {
            uint32_t* row = (uint32_t*)((uint8_t*)s->pixels + y * s->pitch);
            for (int x = 0; x < s->w; ++x) {
                uint32_t p = row[x];
                if ((p & 0xFF000000u) == 0) continue; // skip transparent
                sumR += (p >> 16) & 0xFFu;
                sumG += (p >> 8)  & 0xFFu;
                sumB += (p >> 0)  & 0xFFu;
                ++count;
            }
        }
        if (count > 0) {
            float r = (float)sumR / (255.0f * (float)count);
            float g = (float)sumG / (255.0f * (float)count);
            float b = (float)sumB / (255.0f * (float)count);
            float m = r; if (g > m) m = g; if (b > m) m = b; if (m < 1e-4f) m = 1.0f;
            g_weapon_tint[i][0] = r / m;
            g_weapon_tint[i][1] = g / m;
            g_weapon_tint[i][2] = b / m;
        }
    }
}

// Export weapon tint for renderer effects (used by renderer.cpp)
void Hud_GetWeaponTint(int wepIndex, float& r, float& g, float& b)
{
    if (wepIndex < 0) wepIndex = 0;
    if (wepIndex > 4) wepIndex = 4;
    r = g_weapon_tint[wepIndex][0];
    g = g_weapon_tint[wepIndex][1];
    b = g_weapon_tint[wepIndex][2];
}


